{
  "name": "qarzhy-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "prisma generate && tsc --noEmit && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons:generate": "node scripts/create-icons.cjs",
    "check:publish": "node scripts/check-publish.mjs",
    "check:vercel": "node --experimental-strip-types scripts/check-vercel.mjs",
    "build:vercel": "npm run check:vercel && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:local": "node --env-file=.env scripts/local-db.mjs",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "next": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "three": "^0.186.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "6.19.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
