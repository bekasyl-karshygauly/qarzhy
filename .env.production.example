# Copy to .env.production ON THE SERVER and fill in privately.
# This example contains no working passwords or API keys.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
# Docker Compose supplies DATABASE_URL from POSTGRES_PASSWORD.
# Outside Compose replace this with the actual production PostgreSQL URL.
DATABASE_URL=postgresql://qarzhy:REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD@postgres:5432/qarzhy?schema=public
APP_URL=https://YOUR_DOMAIN
ALLOW_REGISTRATION=false
COOKIE_SECURE=true
DATA_OPERATOR_NAME=
DATA_OPERATOR_CONTACT=

# Optional Gemini educational assistant. Keep the API key on the server only.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
AI_PROVIDER_NAME="Google Gemini · бесплатный API"
AI_PROCESSING_COUNTRY="Глобальная инфраструктура Google; фиксированная страна не гарантируется"
AI_CONTEXT_MODE=general
AI_GOOGLE_PAID_SERVICES=false
# Voice was deferred by the user and is not connected for Gemini.
VOICE_MODEL=
