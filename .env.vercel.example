# Add these settings privately in Vercel, not in a committed .env file.
# Replace the placeholder with an approved remote/pooler PostgreSQL URL.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_DB_HOST/qarzhy?schema=public&sslmode=require&sslaccept=strict&connection_limit=1&pool_timeout=10
# Leave empty for the exact trusted Vercel system URL; set for a custom domain.
# Enable System Environment Variables in Vercel settings.
APP_URL=
COOKIE_SECURE=true
ALLOW_REGISTRATION=false
DATA_OPERATOR_NAME=
DATA_OPERATOR_CONTACT=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
AI_PROVIDER_NAME="Google Gemini · бесплатный API"
AI_PROCESSING_COUNTRY="Глобальная инфраструктура Google; фиксированная страна не гарантируется"
AI_CONTEXT_MODE=general
AI_GOOGLE_PAID_SERVICES=false
VOICE_MODEL=
