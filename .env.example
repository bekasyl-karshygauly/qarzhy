DATABASE_URL=postgresql://qarzhy:REPLACE_PASSWORD@127.0.0.1:55432/qarzhy?schema=public
APP_URL=http://127.0.0.1:3100
ALLOW_REGISTRATION=true
# Set false behind HTTPS only for local smoke tests. Production must use secure cookies.
COOKIE_SECURE=false
# Optional. Provider endpoint, model, name and truthful processing-location disclosure must be explicit.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_PROVIDER_NAME=
AI_PROCESSING_COUNTRY=
VOICE_MODEL=
# general sends only the typed question; financial can attach the monthly summary.
AI_CONTEXT_MODE=general
# Set true only after confirming paid-service terms on this Gemini API project.
# Unpaid/unknown Gemini always stays general. Gemini voice is not integrated.
AI_GOOGLE_PAID_SERVICES=false
# Complete before public deployment; also update the privacy notice.
DATA_OPERATOR_NAME=
DATA_OPERATOR_CONTACT=
